{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(favicon\\.png|LOGO_GPIB_BANDA_ACEH\\.png|COVER\\.pdf|ISI\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
